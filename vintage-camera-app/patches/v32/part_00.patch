+        LensCandidate(String id, float equivalentFocal, boolean logical,
+                float minZoom, float maxZoom) {
+            this.id = id;
+            this.equivalentFocal = equivalentFocal;
+            this.logical = logical;
+            this.minZoom = minZoom;
+            this.maxZoom = maxZoom;
+        }
+
+        float opticalRatio(float mainEquivalentFocal) {
+            if (Float.isNaN(equivalentFocal) || equivalentFocal <= 0f || mainEquivalentFocal <= 0f) {
+                return 1f;
+            }
+            return equivalentFocal / mainEquivalentFocal;
+        }
+
+        boolean supports(float displayZoom, float mainEquivalentFocal) {
+            float optical = opticalRatio(mainEquivalentFocal);
+            float minimum = optical * minZoom;
+            float maximum = optical * maxZoom;
+            return displayZoom >= minimum - 0.04f && displayZoom <= maximum + 0.08f;
+        }
+    }
